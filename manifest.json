{
  "manifest_version": 3,
  "name": "Restaurar fechas y vistas de YouTube",
  "version": "1.1.3",
  "description": "Restaura el formato largo de fechas (\"hace 3 meses\") y de vistas (\"13 mil vistas\") que YouTube abrevió. Basado en patrones de texto, no en clases CSS.",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": ["storage"],

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["constants.js", "utils.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "yt-restaurar-fechas@ejemplo.dev",
      "strict_min_version": "115.0"
    }
  }
}
