{
  "manifest_version": 3,
  "name": "Restore YouTube Dates & Views",
  "version": "1.1.11",
  "description": "Restores the long format of YouTube dates (\"3 months ago\") and view counts (\"13 thousand views\") that YouTube shortened. Based on text patterns, not CSS classes.",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": ["storage"],

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["constants.js", "utils.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "restore-youtube-dates-views@example.dev",
      "strict_min_version": "115.0"
    }
  }
}
